digraph {
  node [shape=box];
  edge [fontsize=10];

  subgraph cluster_rtems {
    label="Classic API";
    release [label="/rtems/sem/req/release"];
  }

  subgraph cluster_newlib {
    label="Newlib API";
    post [label="/newlib/req/sys-lock-\nsemaphore-post"];
    val [label="/newlib/val/sys-lock"];
  }

  subgraph cluster_score {
    label="SuperCore";
    sem [label="/score/sem/req/surrender"];
    tq [label="/score/tq/req/surrender"];
  }

  val -> post [label="validation"];
  post -> sem [label="function-\nimplementation"];
  release -> sem [label="function-\nimplementation"];
  sem -> tq [label="function-\nimplementation"];

  release -> sem [label="test-run", style=dashed];
  val -> sem [label="test-run", style=dashed];
  sem -> tq [label="test-run", style=dashed];
}
